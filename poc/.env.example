# Kopiraj u .env (cp .env.example .env) i upiši ključeve. .env je u .gitignore i ne smije se commitati.

# Claude API (LLM izvlačenje polja); bez njega se LLM korak preskače
ANTHROPIC_API_KEY=

# Sudski registar (https://sudreg-data.gov.hr/ -> Registracija); bez njih se koristi mock
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=

# Opcionalno
# POC_LLM_BUDGET_USD=1.5
# POC_MAX_DETAILS=40
