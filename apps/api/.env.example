# Copy to .env and fill in. .env is gitignored, never commit it.

# Claude API. Without a key the app still runs and AI steps are skipped.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_ELIGIBILITY_MODEL=claude-sonnet-5-5
LLM_BUDGET_USD=2.0

# Sudski registar (Sudreg) OAuth
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=

# Key for /api/admin/* routes (header X-Admin-Key)
ADMIN_KEY=

# Database (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5433/datathon
DB_USER=datathon
DB_PASSWORD=datathon

# Load the seed snapshot on first start
SEED_ENABLED=true
